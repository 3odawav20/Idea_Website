# Public browser configuration for a live Supabase project.
# Fill with your EXISTING active project's URL and PUBLIC publishable/anon key.
# Never add service_role, sb_secret_* or admin credentials here.
# Vite reads these settings at BUILD TIME. Rebuild + redeploy after changing them.
VITE_SUPABASE_URL=https://YOUR_ACTIVE_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
